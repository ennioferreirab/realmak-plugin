# Copie para .env e preencha. O .env nunca vai para o Git.

# Galeed (obrigatório). Raiz do gateway, terminando em /v1. Sem barra no fim.
# Cada usuário manda a própria chave gld_live_... como Bearer; a chave NÃO fica aqui.
GALEED_API_URL=
# Tempo máximo por chamada ao Galeed, em milissegundos (padrão 30000)
GALEED_TIMEOUT_MS=

# ConLicitação
CONLICITACAO_URL=
CONLICITACAO_TOKEN=
CONLICITACAO_LOGIN=
CONLICITACAO_SITE_PASSWORD=
# Caminho do arquivo de sessão (no volume). Padrão: /data/conlicitacao-sessao.json
CONLICITACAO_SESSION_FILE=

# Login de pessoa pelo botão Connect (OAuth). Liga quando há URL pública, segredo, chave de
# serviço e ao menos uma forma de login. Ver DEPLOY.md, seção 6.
# URL pública do servidor, sem barra no fim (ex.: https://mcp.exemplo.com)
MCP_REALMAK_PUBLIC_URL=
# Segredo de 32+ caracteres que cifra códigos e tokens (openssl rand -hex 32). Trocar desconecta todo mundo.
MCP_REALMAK_OAUTH_SECRET=
# Chave gld_live_ de um agente do Galeed listado em GALEED_ACT_AS_PRINCIPALS no Galeed
GALEED_SERVICE_KEY=
# Forma 1: Google Workspace (cliente OAuth "Aplicativo da Web" no Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínio do Workspace aceito (ex.: realmak.com.br). Vazio aceita qualquer conta Google verificada.
GOOGLE_WORKSPACE_DOMAIN=
# Forma 2: conta do Galeed (raiz do painel, onde fica /auth/login)
GALEED_LOGIN_URL=
# Forma 3: código por e-mail (SMTP; porta 587 usa STARTTLS, 465 usa TLS direto)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Hosts extras aceitos como redirect do OAuth, além de claude.ai, claude.com e localhost
# MCP_REALMAK_OAUTH_REDIRECT_HOSTS=

# Opcionais
# MCP_REALMAK_TOKEN_CACHE_SECONDS=300
# MCP_REALMAK_MAX_RESULT_CHARS=100000
# MCP_REALMAK_LOG_LEVEL=INFO
