# Copie para .env e preencha. O .env nunca vai para o Git.

# Galeed (obrigatório). Raiz do gateway, terminando em /v1. Sem barra no fim.
# Cada usuário manda a própria chave gld_live_... como Bearer; a chave NÃO fica aqui.
GALEED_API_URL=
# Tempo máximo por chamada ao Galeed, em milissegundos (padrão 30000)
GALEED_TIMEOUT_MS=

# ConLicitação
CONLICITACAO_URL=
CONLICITACAO_TOKEN=
CONLICITACAO_LOGIN=
CONLICITACAO_SITE_PASSWORD=
# Caminho do arquivo de sessão (no volume). Padrão: /data/conlicitacao-sessao.json
CONLICITACAO_SESSION_FILE=

# Opcionais
# MCP_REALMAK_TOKEN_CACHE_SECONDS=300
# MCP_REALMAK_MAX_RESULT_CHARS=100000
# MCP_REALMAK_LOG_LEVEL=INFO
